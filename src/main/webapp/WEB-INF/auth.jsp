<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#080808"><title>HabitFlow | <c:out value="${mode}"/></title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/styles.css?v=20261111-5"><link rel="preconnect" href="https://fonts.googleapis.com"><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@700;800&display=swap" rel="stylesheet"><style>
html,body{min-height:100%;margin:0;background:var(--hf-canvas,#080808);color:var(--hf-text,#f5f5f7);font-family:'DM Sans',sans-serif}.auth-shell{min-height:100vh;display:grid;place-items:center;padding:24px;background:radial-gradient(ellipse at 50% 100%,rgba(239,35,35,.12),transparent 55%)}.auth-card{width:min(100%,430px);padding:34px;background:var(--hf-surface,#111114);border:1px solid var(--hf-border,#26262b);border-radius:20px;box-shadow:0 25px 80px #0005}.auth-brand{display:flex;align-items:center;gap:12px;margin-bottom:32px;font:800 22px 'Plus Jakarta Sans',sans-serif}.brand-mark{display:grid;place-items:center;width:40px;height:40px;border-radius:12px;background:#e11d2e;color:white}.auth-card h1{margin:0 0 8px;font:800 28px 'Plus Jakarta Sans',sans-serif}.auth-card p{color:var(--hf-subtext,#a1a1aa);margin:0 0 24px}.auth-card form{display:grid;gap:15px}.auth-card label{display:grid;gap:7px;color:var(--hf-subtext,#a1a1aa);font-size:13px;font-weight:600}.auth-card input{height:44px;padding:0 12px;border-radius:10px;border:1px solid var(--hf-border,#333);background:var(--hf-canvas,#080808);color:var(--hf-text,#fff);font:inherit}.auth-card button{min-height:46px;border:0;border-radius:10px;background:#e11d2e;color:white;font:700 14px 'DM Sans',sans-serif;cursor:pointer}.auth-card .auth-error{padding:11px;border-radius:9px;background:rgba(239,35,35,.12);color:#ff7777}.auth-switch{margin-top:20px!important;text-align:center}.auth-switch a{color:#ff4b56;font-weight:700;text-decoration:none}
</style></head><body><main class="auth-shell"><section class="auth-card"><div class="auth-brand"><span class="brand-mark">H</span><span>Habit<span style="color:#ef2323">Flow</span></span></div><h1><c:choose><c:when test="${mode eq 'register'}">Create your account</c:when><c:otherwise>Welcome back</c:otherwise></c:choose></h1><p>Your private routine, saved across your devices.</p><c:if test="${not empty error}"><div class="auth-error" role="alert"><c:out value="${error}"/></div></c:if>
<form method="post" action="${pageContext.request.contextPath}/${mode eq 'register' ? 'register' : 'login'}"><input type="hidden" name="csrfToken" value="<c:out value='${csrfToken}'/>"/><c:if test="${mode eq 'register'}"><label>Your name<input name="name" autocomplete="name" required minlength="2" maxlength="80" value="<c:out value='${param.name}'/>"/></label></c:if><label>Email<input type="email" name="email" autocomplete="email" required maxlength="254" value="<c:out value='${param.email}'/>"/></label><label>Password<input type="password" name="password" autocomplete="${mode eq 'register' ? 'new-password' : 'current-password'}" required minlength="10" maxlength="72"/></label><c:if test="${mode eq 'register'}"><small style="color:var(--hf-subtext,#a1a1aa)">Use 10 or more characters. Passwords are encrypted before they are stored.</small></c:if><button type="submit"><c:out value="${mode eq 'register' ? 'Create account' : 'Sign in'}"/></button></form><p class="auth-switch"><c:choose><c:when test="${mode eq 'register'}">Already have an account? <a href="${pageContext.request.contextPath}/login">Sign in</a></c:when><c:otherwise>New to HabitFlow? <a href="${pageContext.request.contextPath}/register">Create account</a></c:otherwise></c:choose></p></section></main></body></html>
