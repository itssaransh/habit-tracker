<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="theme-color" content="#F8FAFC">
<meta name="csrf-token" content="<c:out value='${csrfToken}'/>">
<title>HabitFlow | Personal habit tracker</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@700;800&display=swap" rel="stylesheet">
<script>try { const dark = '${theme}' === 'dark'; if (dark) document.documentElement.classList.add('dark'); document.querySelector('meta[name="theme-color"]').content = dark ? '#080808' : '#F8FAFC'; } catch (error) { document.querySelector('meta[name="theme-color"]').content = '#F8FAFC'; }</script>
<link rel="stylesheet" href="${pageContext.request.contextPath}/assets/styles.css?v=20261111-6"><script defer src="${pageContext.request.contextPath}/assets/app.js?v=20261111-auth1"></script>
</head>
<body data-base="${pageContext.request.contextPath}/" data-weekly="${stats.weeklyCompletions}" data-total-habits="${stats.totalHabits}">
<div class="app-shell">
<aside class="sidebar">
    <div class="sidebar-brand"><a class="brand" href="${pageContext.request.contextPath}/"><span class="brand-mark">H</span><span>Habit<span class="brand-flow">Flow</span></span></a>
        <button class="theme-toggle" id="theme-toggle" data-theme-toggle type="button" aria-label="${theme eq 'dark' ? 'Switch to light mode' : 'Switch to dark mode'}" title="Change theme"><svg class="moon-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 15A8.5 8.5 0 0 1 9 4a8.5 8.5 0 1 0 11 11Z"/></svg><svg class="sun-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l-1.4-1.4m11.4-11.4 1.4 1.4"/></svg></button>
    </div>
    <p class="side-label">WORKSPACE</p>
    <nav class="side-nav" aria-label="Main navigation">
        <button class="nav-link active" type="button" data-view="dashboard"><span class="nav-icon">⌂</span>Dashboard</button><button class="nav-link" type="button" data-view="matrix"><span class="nav-icon">▦</span>Weekly Matrix</button><button class="nav-link" type="button" data-view="analytics"><span class="nav-icon">↗</span>Analytics</button><button class="nav-link" type="button" data-view="timer"><span class="nav-icon">◷</span>Focus Timer</button><button class="nav-link" type="button" data-view="templates"><span class="nav-icon">◇</span>Blueprints</button>
    </nav>
    <div class="sidebar-footer">
        <span class="sidebar-footer-glow" aria-hidden="true"></span>
        <button class="side-add" type="button" onclick="openModal()"><span>＋</span> Add a habit</button>
        <section class="momentum-card"><div class="momentum-top"><span>Daily momentum</span><strong id="momentum-percent">0%</strong></div><div class="momentum-track"><span id="momentum-fill"></span></div><p>Small steps. Consistency beats intensity. Show up today.</p></section>
        <button class="sidebar-profile" id="profile-menu-toggle" type="button" aria-expanded="false"><span class="profile-avatar"><c:out value="${account.displayName.substring(0,1).toUpperCase()}"/></span><span class="profile-copy"><strong><c:out value="${account.displayName}"/></strong><span><c:out value="${account.email}"/></span></span><span class="profile-count">⌄</span></button><div class="profile-dropdown" id="profile-dropdown" hidden><button type="button" id="open-account-settings">Account settings</button><form method="post" action="${pageContext.request.contextPath}/logout"><input type="hidden" name="csrfToken" value="<c:out value='${csrfToken}'/>"/><button type="submit">Sign out</button></form></div>
        <div class="sidebar-wave" aria-hidden="true"><svg viewBox="0 0 280 68" fill="none" style="width: 100%; height: 100%;" preserveAspectRatio="none">
            <defs>
                <linearGradient id="hfWavePrimary" x1="0" y1="0" x2="1" y2="0">
                    <stop offset="0%" stop-color="rgba(239, 35, 35, 0.16)" />
                    <stop offset="32%" stop-color="#FF3B3B" />
                    <stop offset="62%" stop-color="#EF2323" />
                    <stop offset="100%" stop-color="rgba(200, 20, 20, 0.25)" />
                </linearGradient>
                <linearGradient id="hfWaveSecondary" x1="0" y1="0" x2="1" y2="0">
                    <stop offset="0%" stop-color="rgba(239, 35, 35, 0.20)" />
                    <stop offset="48%" stop-color="#EF2323" />
                    <stop offset="100%" stop-color="rgba(239, 35, 35, 0.18)" />
                </linearGradient>
                <linearGradient id="hfWaveSubtle" x1="0" y1="0" x2="1" y2="0">
                    <stop offset="0%" stop-color="rgba(239, 35, 35, 0.06)" />
                    <stop offset="50%" stop-color="rgba(239, 35, 35, 0.48)" />
                    <stop offset="100%" stop-color="rgba(239, 35, 35, 0.08)" />
                </linearGradient>
                <filter id="hfCrimsonGlow" x="-15%" y="-40%" width="130%" height="180%">
                    <feGaussianBlur stdDeviation="2.2" result="blur" />
                    <feMerge><feMergeNode in="blur" /><feMergeNode in="SourceGraphic" /></feMerge>
                </filter>
            </defs>
            <path d="M-12 28 C 52 14, 118 30, 182 18 C 228 11, 258 24, 292 36 L 292 48 C 245 34, 195 24, 128 28 C 65 32, 18 42, -12 46 Z" fill="rgba(239, 35, 35, 0.09)" />
            <path d="M-12 48 C 72 31, 178 31, 292 24" stroke="url(#hfWaveSubtle)" stroke-width="1.15" />
            <path d="M-12 34 C 46 14, 108 28, 176 23 C 226 19, 258 11, 292 3" stroke="url(#hfWaveSecondary)" stroke-width="1.9" filter="url(#hfCrimsonGlow)" />
            <path d="M-12 23 C 54 33, 122 10, 192 15 C 234 18, 264 28, 292 39" stroke="url(#hfWavePrimary)" stroke-width="2.5" filter="url(#hfCrimsonGlow)" />
            <path d="M-12 18 C 62 28, 148 25, 292 33" stroke="url(#hfWaveSubtle)" stroke-width="0.9" />
        </svg></div>
    </div>
</aside>
<main class="content">
    <div class="mobile-topbar"><a class="brand" href="${pageContext.request.contextPath}/"><span class="brand-mark">H</span><span>Habit<span class="brand-flow">Flow</span></span></a><div class="mobile-top-actions"><span class="mobile-done">${stats.completedToday}/${stats.totalHabits} done</span><button class="theme-toggle mobile-theme-toggle" data-theme-toggle type="button" aria-label="${theme eq 'dark' ? 'Switch to light mode' : 'Switch to dark mode'}" title="Change theme"><svg class="moon-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 15A8.5 8.5 0 0 1 9 4a8.5 8.5 0 1 0 11 11Z"/></svg><svg class="sun-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4m11.4-11.4 1.4-1.4"/></svg></button><button type="button" onclick="openModal()" aria-label="Add a habit">＋</button></div></div>
    <header class="page-header"><div><p class="eyebrow">${todayDay}, ${today}</p><h1>Good morning, achiever 👋</h1><div class="hf-compound-tagline" style="margin-top: 10px; display: flex; flex-wrap: wrap; align-items: center; gap: 10px; font-size: 15px; font-weight: 800; letter-spacing: 0.03em;">
      <svg viewBox="0 0 24 18" fill="none" aria-hidden="true" style="width: 24px; height: 18px; flex-shrink: 0;">
        <defs>
          <linearGradient id="hfTrendArea" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#EF2323" stop-opacity="0.42" />
            <stop offset="100%" stop-color="#EF2323" stop-opacity="0.0" />
          </linearGradient>
        </defs>
        <path d="M2 14.5 L8.5 9.5 L13 12.5 L21.5 3.5 L21.5 16.5 L2 16.5 Z" fill="url(#hfTrendArea)" />
        <path d="M2 14.5 L8.5 9.5 L13 12.5 L21.5 3.5" stroke="#EF2323" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
        <path d="M16.5 3.5 H21.5 V8.5" stroke="#EF2323" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      <span style="text-transform: uppercase; letter-spacing: 0.04em;">1% BETTER EVERY DAY</span>
      <span aria-hidden="true" style="width: 1.5px; height: 16px; background: currentColor; opacity: 0.35; margin: 0 4px;"></span>
      <span style="font-variant-numeric: tabular-nums; letter-spacing: -0.01em;">1.01<sup style="font-size: 0.68em; font-weight: 800; margin-left: 1px;">365</sup> = 37.78&times;</span>
    </div></div><div class="header-actions"><span id="sync-status" class="sync-status" role="status" aria-live="polite">Connecting…</span><button type="button" class="account-settings-trigger" id="header-account-settings" aria-label="Account settings"><c:out value="${account.displayName.substring(0,1).toUpperCase()}"/></button><div class="date-pill"><span class="date-dot"></span><span id="live-date"></span></div><button class="primary-btn" type="button" onclick="openModal()"><span class="primary-icon">＋</span><span class="primary-label">New habit</span></button></div></header>
    <c:if test="${not empty param.message or not empty param.error}"><div class="alert-banner ${not empty param.error ? 'alert-error' : 'alert-success'}" id="flash-banner" role="status"><span class="alert-symbol">${not empty param.error ? '!' : '✓'}</span><span class="alert-copy"><c:out value="${not empty param.error ? param.error : param.message}" /></span><button type="button" class="alert-dismiss" aria-label="Dismiss message">×</button></div></c:if>
    <section class="workspace-view active" id="view-dashboard">
        <div class="stats-grid">
            <article class="stat-card"><div class="stat-head"><span>Active habits</span><span class="stat-icon purple-icon">▦</span></div><strong class="stat-number">${stats.totalHabits}</strong><small>Keep building momentum</small></article>
            <article class="stat-card"><div class="stat-head"><span>Completed today</span><span class="stat-icon green-icon">✓</span></div><strong class="stat-number">${stats.completedToday}<span class="stat-denom"> / ${stats.totalHabits}</span></strong><small><span id="daily-rate">0%</span> daily target complete</small></article>
            <article class="stat-card"><div class="stat-head"><span>Best streak</span><span class="stat-icon orange-icon">↗</span></div><strong class="stat-number">${stats.bestStreak}<span class="stat-denom"> days</span></strong><small>Protect your progress</small></article>
            <article class="stat-card"><div class="stat-head"><span>Check-ins</span><span class="stat-icon blue-icon">◎</span></div><strong class="stat-number">${stats.weeklyCompletions}</strong><small>Your consistency this week</small></article>
        </div>
        <div class="section-heading dashboard-heading" id="habits"><div><p class="section-kicker">YOUR ROUTINE</p><h2>Today’s habits</h2><p>Check in today or tap an earlier date to update your account history.</p></div></div>
        <div class="filter-panel">
            <div class="filter-top"><label class="search-box"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 5 5"/></svg><input id="habit-search" type="search" placeholder="Filter habits..." aria-label="Filter habits"></label><span class="showing-count" id="showing-count">Showing 0 of 0</span></div>
            <div class="filter-row"><div class="filter-label">CATEGORY</div><div class="filter-pills" id="category-filters"><button class="filter-pill active" type="button" data-category-filter="All">All</button><button class="filter-pill" type="button" data-category-filter="Mind">Mind</button><button class="filter-pill" type="button" data-category-filter="Body">Body</button><button class="filter-pill" type="button" data-category-filter="Career">Career</button><button class="filter-pill" type="button" data-category-filter="Wellness">Wellness</button><button class="filter-pill" type="button" data-category-filter="Learning">Learning</button></div></div>
            <div class="filter-row time-filter-row"><div class="filter-label">TIME OF DAY</div><div class="time-pills" id="time-filters"><button class="time-pill active" type="button" data-time-filter="All">All times</button><button class="time-pill" type="button" data-time-filter="Morning">Morning</button><button class="time-pill" type="button" data-time-filter="Afternoon">Afternoon</button><button class="time-pill" type="button" data-time-filter="Evening">Evening</button><button class="time-pill" type="button" data-time-filter="Anytime">Anytime</button></div></div>
        </div>
        <div class="habit-list" id="habit-list">
            <c:choose><c:when test="${empty habits}"><div class="empty-state"><span class="empty-mark">H</span><h3>Your routine starts here</h3><p>Add a small habit and make room for steady progress.</p><button class="primary-btn" type="button" onclick="openModal()">Create first habit</button></div></c:when><c:otherwise>
                <c:forEach var="habit" items="${habits}">
                    <article class="habit-card" data-habit-id="${habit.id}" data-category="${habit.category}" data-color="${habit.color}" data-frequency="${habit.frequency}" data-completed="${habit.completedToday}" data-scheduled="${habit.scheduledToday}" data-created="${habit.createdAt}">
                        <div class="habit-accent" style="--habit-color:${habit.color}"></div>
                        <div class="habit-check-column"><form method="post" action="${pageContext.request.contextPath}/checkins" class="checkin-form"><input type="hidden" name="csrfToken" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="habitId" value="${habit.id}"><input type="hidden" name="note" value=""><button class="check-btn ${habit.completedToday ? 'checked' : ''}" type="submit" ${not habit.scheduledToday ? 'disabled' : ''} aria-label="${habit.completedToday ? 'Undo today check-in' : 'Mark habit complete'}" title="${not habit.scheduledToday ? 'Not scheduled today' : (habit.completedToday ? 'Undo check-in' : 'Mark complete')}">${habit.completedToday ? '✓' : '○'}</button></form></div>
                        <div class="habit-main"><div class="habit-meta"><span class="habit-category"><c:out value="${habit.category}" /></span><span class="meta-separator">·</span><span><c:out value="${habit.frequency}" /></span><span class="meta-separator">·</span><span class="time-label">Anytime</span><span class="meta-separator">·</span><span class="mono">♨ ${habit.currentStreak}d</span><span class="meta-separator">·</span><span class="mono">${habit.completionRate}% month</span><span class="focus-badge" hidden></span></div><h3 class="habit-title"><c:out value="${habit.name}" /></h3><p class="habit-description"><c:out value="${habit.description}" /></p>
                            <div class="target-row"><div class="target-track"><span class="target-fill"></span></div><span class="target-count mono">0 / 1</span><button class="target-step" type="button" data-target-change="-1" aria-label="Decrease daily target progress">−</button><button class="target-step" type="button" data-target-change="1" aria-label="Increase daily target progress">+</button></div></div>
                        <div class="habit-week" aria-label="Last seven days"><div class="week-strip"></div><span class="week-caption">LAST 7 DAYS</span></div>
                        <div class="habit-actions"><button class="icon-btn focus-habit" type="button" title="Start a focus session" aria-label="Start a focus session">▶</button><button class="icon-btn note-toggle" type="button" title="Daily note and schedule" aria-label="Open daily note">▤</button><button class="icon-btn edit-btn" type="button" title="Edit habit" aria-label="Edit habit">✎</button><button class="icon-btn delete-btn" type="button" data-id="${habit.id}" title="Delete habit" aria-label="Delete habit">×</button></div>
                        <div class="note-drawer" hidden role="dialog" aria-modal="true" aria-label="Habit notes and reflections"><section class="note-modal"><div class="note-modal-heading"><div><span class="modal-kicker">HABIT JOURNAL</span><h2><span class="note-habit-name"></span> — Log &amp; Reflections</h2><p>Record a quick reflection for today.</p></div><button type="button" class="note-close" aria-label="Close notes">×</button></div><div class="note-history" aria-live="polite"></div><label>Today’s note<textarea class="daily-note" maxlength="500" placeholder="A quick reflection for today..."></textarea></label><div class="note-settings"><label>Time of day<select class="time-select"><option>Anytime</option><option>Morning</option><option>Afternoon</option><option>Evening</option></select></label><span class="local-note">Saved to your account and available on your devices.</span><button class="save-note-btn" type="button">Save note</button></div></section></div>
                    </article>
                </c:forEach>
            </c:otherwise></c:choose>
        </div>
        <section class="insight-card"><div class="insight-mark">✦</div><div class="insight-copy"><span class="section-kicker">A NOTE FOR TODAY</span><strong id="insight-title">Small steps add up</strong><p id="insight-message">Every journey begins with one check-in. What will you complete first?</p></div><button type="button" class="text-action" data-open-view="timer">Plan a focus session <span>→</span></button></section>
    </section>
    <section class="workspace-view" id="view-matrix"><div class="view-intro"><p class="section-kicker">CONSISTENCY GRID</p><h2>Weekly Matrix</h2><p>Inspect your routine day by day. Select a date cell to change its completion.</p></div><div class="matrix-window-controls" role="group" aria-label="Choose matrix date range"><button type="button" data-matrix-days="7" class="active" aria-pressed="true">7 days</button><button type="button" data-matrix-days="14" aria-pressed="false">14 days</button></div><div class="panel-card matrix-card"><div class="panel-heading"><div><h3>Routine log</h3><p>Check-ins and past-day updates are saved to your account.</p></div><span class="panel-badge" id="matrix-window-label">7 DAYS</span></div><div class="table-scroll"><table class="matrix-table" id="matrix-table"></table></div></div><div class="panel-card daily-summary"><div><span class="section-kicker">WEEKLY PROGRESS</span><h3>Daily completion summary</h3></div><div class="summary-days" id="summary-days"></div></div></section>
    <section class="workspace-view" id="view-analytics">
        <div class="view-intro"><p class="section-kicker">YOUR PROGRESS</p><h2>Analytics &amp; Consistency</h2><p>28-day completion intensity, category balance, and active streak rankings.</p></div>
        <div class="analytics-stats"><article class="panel-card metric-card"><span>Weekly consistency rate</span><strong class="mono" id="consistency-score">0%</strong><small>Based on this week’s scheduled check-ins</small></article><article class="panel-card metric-card"><span>Best streak</span><strong class="mono" id="analytics-best-streak">${stats.bestStreak} days</strong><small>Longest consecutive completion record</small></article><article class="panel-card metric-card"><span>Today’s completion</span><strong class="mono" id="analytics-today-rate">0%</strong><small>${stats.completedToday} of ${stats.totalHabits} active habits completed today</small></article></div>
        <div class="analytics-grid">
            <article class="panel-card heatmap-card"><div class="panel-heading"><div><h3>28-Day Daily Momentum Heatmap</h3><p>Each tile shows the share of scheduled habits completed that day.</p></div><span class="heatmap-legend"><span>Less</span><i></i><i></i><i></i><i></i><span>More</span></span></div><div class="intensity-heatmap" id="intensity-heatmap" aria-label="28-day habit completion heatmap"></div></article>
            <article class="panel-card category-card"><div class="panel-heading"><div><h3>Category Performance</h3><p>Average completion rate in each area.</p></div></div><div id="category-breakdown" class="category-breakdown"></div></article>
            <article class="panel-card leaderboard-card"><div class="panel-heading"><div><h3>Active Streak Leaderboard</h3><p>Your strongest consecutive habit chains right now.</p></div></div><div id="leaderboard" class="leaderboard"></div></article>
            <details class="panel-card history-details"><summary>View 16-week history and export routine data</summary><div class="history-detail-content"><article class="history-heatmap-card"><div class="panel-heading"><div><h3>Consistency over time</h3><p>16 weeks · your check-ins sync from your account</p></div></div><div class="heatmap-months" id="heatmap-months"></div><div class="heatmap" id="heatmap" aria-label="16-week habit check-in heatmap"></div><div class="heatmap-days"><span>Mon</span><span>Wed</span><span>Fri</span></div></article><div class="history-export"><p>Export your habits, saved notes, check-ins, and focus sessions.</p><button class="secondary-btn" id="export-data" type="button">Export JSON</button></div></div></details>
        </div><p class="storage-note">Your habits, notes, goals, check-ins, and focus sessions are saved to your account and sync across devices.</p>
    </section>
    <section class="workspace-view" id="view-timer">
        <div class="view-intro"><p class="section-kicker">MAKE SPACE TO FOCUS</p><h2>Focus Timer</h2><p>Choose a habit and work in a short, focused session.</p></div>
        <div class="timer-layout"><article class="panel-card timer-card">
            <label class="timer-habit-label">FOCUSING ON<select id="timer-habit"><option value="">Choose a habit</option><c:forEach var="habit" items="${habits}"><option value="${habit.id}"><c:out value="${habit.name}" /></option></c:forEach></select></label>
            <div class="timer-ring"><svg viewBox="0 0 220 220" aria-hidden="true"><circle class="ring-track" cx="110" cy="110" r="94"></circle><circle class="ring-progress" id="ring-progress" cx="110" cy="110" r="94"></circle></svg><div class="timer-readout"><strong id="timer-display">25:00</strong><span id="timer-state">READY WHEN YOU ARE</span></div></div>
            <div class="timer-presets"><button type="button" class="preset-btn active" data-minutes="25"><strong>25m</strong><span>Focus</span></button><button type="button" class="preset-btn" data-minutes="50"><strong>50m</strong><span>Deep Work</span></button><button type="button" class="preset-btn" data-minutes="15"><strong>15m</strong><span>Sprint</span></button><button type="button" class="preset-btn" data-minutes="5"><strong>5m</strong><span>Rest</span></button></div>
            <div class="timer-controls"><button type="button" class="primary-btn" id="timer-start">Start focus</button><button type="button" class="secondary-btn" id="timer-reset">Reset</button><button type="button" class="secondary-btn complete-session" id="timer-complete">Complete &amp; log session</button></div><p class="timer-local-note">Completed focus sessions are saved to your account. A session can also check in the selected habit.</p>
        </article><aside class="panel-card timer-side"><span class="side-illustration">◷</span><p class="section-kicker">ONE THING AT A TIME</p><h3>Give one habit your attention.</h3><p>Pick a session length, put away distractions, and start when you are ready. You can pause or reset at any time.</p><div class="focus-total-card"><span>FOCUS TIME LOGGED</span><strong id="timer-side-total">0 min</strong></div></aside></div>
    </section>
    <section class="workspace-view" id="view-templates"><div class="view-intro"><p class="section-kicker">A PLACE TO START</p><h2>Habit blueprints</h2><p>Choose a simple starting point and adjust it to fit your routine.</p></div>
        <div class="blueprint-grid">
            <article class="blueprint-card"><span class="blueprint-icon indigo-bg">⌘</span><span class="blueprint-category">CAREER</span><h3>Deep Work Architecture Sprint</h3><p>Set aside time for one important task without switching between tabs.</p><button class="blueprint-add" type="button" data-name="Deep Work Architecture Sprint" data-description="Focus on one important task without switching between tabs." data-category="Career" data-frequency="Weekdays" data-color="#5B5FEF">＋ Add to routine</button></article>
            <article class="blueprint-card"><span class="blueprint-icon blue-bg">▤</span><span class="blueprint-category">LEARNING</span><h3>Read 20 Pages of Non-Fiction</h3><p>Build a steady reading habit with a small daily goal.</p><button class="blueprint-add" type="button" data-name="Read 20 Pages of Non-Fiction" data-description="Read a few pages and note one useful idea." data-category="Learning" data-frequency="Daily" data-color="#2583D8">＋ Add to routine</button></article>
            <article class="blueprint-card"><span class="blueprint-icon orange-bg">↗</span><span class="blueprint-category">BODY</span><h3>Strength &amp; Posture Mobility</h3><p>Take a short movement break to stretch and reset your posture.</p><button class="blueprint-add" type="button" data-name="Strength &amp; Posture Mobility" data-description="Take a short movement break to stretch and reset your posture." data-category="Body" data-frequency="Daily" data-color="#F08C46">＋ Add to routine</button></article>
            <article class="blueprint-card"><span class="blueprint-icon green-bg">◉</span><span class="blueprint-category">WELLNESS</span><h3>Daily Hydration Target</h3><p>Keep water nearby and take regular drink breaks through the day.</p><button class="blueprint-add" type="button" data-name="Daily Hydration Target" data-description="Keep water nearby and take regular drink breaks." data-category="Wellness" data-frequency="Daily" data-color="#0FA77A">＋ Add to routine</button></article>
            <article class="blueprint-card"><span class="blueprint-icon rose-bg">☾</span><span class="blueprint-category">WELLNESS</span><h3>Evening Digital Sunset</h3><p>Set a calm boundary with screens before bedtime.</p><button class="blueprint-add" type="button" data-name="Evening Digital Sunset" data-description="Put away screens for a little while before bedtime." data-category="Wellness" data-frequency="Daily" data-color="#E11D48">＋ Add to routine</button></article>
            <article class="blueprint-card"><span class="blueprint-icon violet-bg">✦</span><span class="blueprint-category">MIND</span><h3>Mindful Gratitude Log</h3><p>Write down one small thing you appreciated today.</p><button class="blueprint-add" type="button" data-name="Mindful Gratitude Log" data-description="Write down one small thing you appreciated today." data-category="Mind" data-frequency="Daily" data-color="#7C3AED">＋ Add to routine</button></article>
        </div>
    </section>
    <nav class="mobile-nav" aria-label="Workspace shortcuts"><button class="active" type="button" data-view="dashboard"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M16 2v4M8 2v4M3 10h18M8 15l2 2 5-5"/></svg><small>Today</small></button><button type="button" data-view="matrix"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg><small>Matrix</small></button><button type="button" data-view="analytics"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 19V10M10 19V5M16 19v-7M22 19H2"/></svg><small>Analytics</small></button><button type="button" data-view="timer"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="13" r="8"/><path d="M12 9v4l3 2M9 2h6M12 2v3"/></svg><small>Timer</small></button><button type="button" data-view="templates"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 9 9-9 9-9-9 9-9Z"/></svg><small>Blueprints</small></button></nav>
</main>
</div>
<div class="modal-backdrop" id="account-settings-modal" aria-hidden="true"><section class="modal account-settings-modal" role="dialog" aria-modal="true" aria-labelledby="account-settings-title"><button class="close-btn" type="button" id="close-account-settings" aria-label="Close settings">×</button><div class="modal-kicker">YOUR ACCOUNT</div><h2 id="account-settings-title">Account settings</h2><p class="modal-subtitle">Update the profile and display preference for this account.</p><form method="post" action="${pageContext.request.contextPath}/account" id="account-settings-form"><input type="hidden" name="csrfToken" value="<c:out value='${csrfToken}'/>"/><label>Display name<input name="displayName" required minlength="2" maxlength="80" value="<c:out value='${account.displayName}'/>"/></label><label>Appearance<select name="theme"><option value="dark" ${theme eq 'dark' ? 'selected' : ''}>Dark mode</option><option value="light" ${theme eq 'light' ? 'selected' : ''}>Light mode</option></select></label><div class="device-prototype"><strong>Signed-in devices</strong><span>Device history is not available yet. Use Sign out to end this session.</span></div><button class="primary-btn full" type="submit">Save settings <span>→</span></button></form><form method="post" action="${pageContext.request.contextPath}/logout" class="account-logout-form"><input type="hidden" name="csrfToken" value="<c:out value='${csrfToken}'/>"/><button class="secondary-btn full" type="submit">Sign out</button></form><p class="account-email"><c:out value="${account.email}"/> · Email verification and password reset are not available yet.</p></section></div>
<div class="modal-backdrop" id="habit-modal" aria-hidden="true"><section class="modal" role="dialog" aria-modal="true" aria-labelledby="modal-title">
    <button class="close-btn" type="button" onclick="closeModal()" aria-label="Close dialog">×</button><div class="modal-kicker" id="habit-modal-kicker">NEW ROUTINE</div><h2 id="modal-title">Create a habit</h2><p class="modal-subtitle">Choose something small enough to repeat and meaningful enough to matter.</p>
    <form method="post" action="${pageContext.request.contextPath}/habits" id="add-habit"><input type="hidden" name="csrfToken" value="<c:out value='${csrfToken}'/>"/><input type="hidden" name="id" id="edit-habit-id" value=""/><input type="hidden" name="targetCount" id="edit-target-count" value="0"/>
        <label>Habit name<input name="name" required maxlength="120" placeholder="e.g. Read for 20 minutes"></label><label>Description<textarea name="description" maxlength="500" placeholder="Why does this habit matter to you?"></textarea></label>
        <div class="form-row"><label>Category<select name="category"><option>Mind</option><option>Body</option><option>Career</option><option>Wellness</option><option>Learning</option></select></label><label>Frequency<select name="frequency"><option>Daily</option><option>Weekdays</option><option>Weekly</option></select></label></div>
        <div class="form-row edit-only" id="edit-settings" hidden><label>Time of day<select name="timeOfDay" id="edit-time-of-day"><option>Anytime</option><option>Morning</option><option>Afternoon</option><option>Evening</option></select></label><label>Daily target<input type="number" name="targetTotal" id="edit-target-total" min="1" max="50" value="1" required></label></div>
        <fieldset class="color-field"><legend>Accent color</legend><div class="color-options"><label><input type="radio" name="color" value="#5B5FEF" checked><span style="--swatch:#5B5FEF"></span></label><label><input type="radio" name="color" value="#0FA77A"><span style="--swatch:#0FA77A"></span></label><label><input type="radio" name="color" value="#F08C46"><span style="--swatch:#F08C46"></span></label><label><input type="radio" name="color" value="#2583D8"><span style="--swatch:#2583D8"></span></label><label><input type="radio" name="color" value="#E11D48"><span style="--swatch:#E11D48"></span></label><label><input type="radio" name="color" value="#7C3AED"><span style="--swatch:#7C3AED"></span></label></div></fieldset>
        <button class="primary-btn full" type="submit" id="habit-submit">Add to my routine <span>→</span></button>
    </form>
</section></div>
<div class="sr-only" id="app-announcements" aria-live="polite"></div>
</body>
</html>
